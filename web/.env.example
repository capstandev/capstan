# Build-time variables of the website (Vite reads VITE_* only; every value ships in the public bundle, so never put a
# secret here). Production values for the Vercel project, Production environment. A value of "set in Vercel" is
# entered in the Vercel project settings, never committed. src/config.ts reads them; test/vercel.test.ts keeps this
# file listing every VITE_ variable the code reads.

# Production: set these in Vercel
VITE_PROFILE=live
VITE_API_BASE=https://api.get-capstan.com/v1
VITE_NETWORK=mainnet
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_WALLETCONNECT_PROJECT_ID: set in Vercel (the Reown project id for get-capstan.com, BACKLOG A9). Unset: browser
# wallets through EIP-6963 only.
VITE_WALLETCONNECT_PROJECT_ID=
# VITE_REOWN_PROJECT_ID: an alias the code also reads. Production: leave unset (use VITE_WALLETCONNECT_PROJECT_ID).
VITE_REOWN_PROJECT_ID=

# Fork profile only (VITE_PROFILE=fork, ops/fork/up.sh sets them). Production: leave unset; the live profile ignores them.
VITE_TOKEN_CHAIN_ID=
VITE_EXPLORER=
VITE_PINS=
VITE_VENUE_HOSTS=
VITE_RECEIPT_SIGNERS=
VITE_ANCHOR=
VITE_ANCHOR_CHAIN_ID=
