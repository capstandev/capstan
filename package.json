{
  "name": "capstan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Non-custodial multi-venue perps API, TS SDK and MCP server",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/api",
    "apps/ws",
    "apps/relay",
    "apps/mcp",
    "apps/workers",
    "apps/facilitator",
    "packages/schema",
    "packages/adapters/hyperliquid",
    "packages/adapters/lighter",
    "packages/adapters/aster",
    "packages/adapters/variational",
    "packages/adapters/arcus",
    "packages/signers/hl",
    "packages/signers/lighter-wasm",
    "packages/signers/aster",
    "packages/sdk",
    "packages/eligibility",
    "packages/receipts",
    "packages/catalog",
    "packages/x402"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:keys": "bun ops/ci/check-key-identifiers.ts",
    "check:banned": "bun ops/ci/check-banned-words.ts",
    "check:guard": "bash .githooks/public-guard.sh",
    "check": "bun run typecheck && bun test && bun run check:keys && bun run check:banned && bun run check:guard",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
