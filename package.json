{
  "name": "capstan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Non-custodial multi-venue perps API, TS SDK and MCP server",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*",
    "packages/signers/*",
    "ops/usage",
    "ops/fork",
    "ops/golive",
    "ops/mainnet",
    "ops/testnet"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "check:keys": "bun ops/ci/check-key-identifiers.ts",
    "check:banned": "bun ops/ci/check-banned-words.ts",
    "check:guard": "bash .githooks/public-guard.sh",
    "check:pins": "bun ops/ci/check-pins.ts",
    "check:deployments": "bun ops/ci/check-deployments.ts",
    "check:vectors": "bun ops/ci/check-vector-files.ts",
    "check": "bun run typecheck && bun test --timeout 30000 && bun run check:keys && bun run check:banned && bun run check:pins && bun run check:deployments && bun run check:vectors && bun run check:guard",
    "db:migrate": "bun packages/core/src/migrate.ts",
    "db:migrate:down": "bun packages/core/src/migrate.ts down",
    "db:generate": "drizzle-kit generate",
    "gen:deployments": "bun ops/ci/gen-deployments.ts",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "openapi": "bun apps/api/src/openapi/generate.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
