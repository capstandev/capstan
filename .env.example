# Copy to .env for local runs. Never commit .env. Every value here is a safe local default: every arming flag and
# mainnet path is off, limits are set, and service signers use the local dev signer (chain 31337 only).
# Service keys are never put in env: production sets <ROLE>_SIGNER=keystore with a keystore path and a password file.

# Shared
CAPSTAN_NETWORK=local
LOG_LEVEL=info
PUBLIC_API_HOST=localhost:8710
DATABASE_URL=postgres://capstan:capstan@127.0.0.1:55432/capstan
REDIS_URL=redis://127.0.0.1:56379
# docker-compose.yml host ports (override per parallel stack)
CAPSTAN_PG_PORT=55432
CAPSTAN_REDIS_PORT=56379
# telemetry: span file (JSON lines) and /metrics port per service; empty means off
OTLP_FILE=
PROM_PORT=

# api
API_PORT=8710
RATE_LIMIT_FREE_PER_MIN=60
RATE_LIMIT_WRITE_PER_MIN=20
STAKER_BUCKET_ENABLED=0
EQ_EXECUTION_ALLOWED=0
X402_ENABLED=0
FACILITATOR_URL=http://127.0.0.1:8714
# the dashboard's origins for CORS (exact, comma separated; empty = no CORS). 22273 is the web dev server.
CAPSTAN_WEB_ORIGINS=http://127.0.0.1:22273

# ws
WS_PORT=8711
WS_MAX_SUBS_PER_CONN=50

# relay
RELAY_PORT=8712
RELAY_EGRESS_ID=local
RELAY_FREE_ORDERS_PER_MIN=2
RELAY_SUBMIT_ARMED=0
RECEIPT_SIGNER=dev
RECEIPT_CHAIN_ID=31337

# mcp
MCP_PORT=8713
API_BASE_URL=http://127.0.0.1:8710/v1
MCP_RATE_LIMIT_PER_MIN=60

# workers
WORKER_JOBS=
ANCHOR_RPC_URL=http://127.0.0.1:8545
ANCHOR_ARMED=0
# mainnet posting needs ANCHOR_ARMED=1 AND this file to exist; leave unset outside production
ANCHOR_ARMED_FILE=
ANCHOR_MIN_BALANCE_WEI=2500000000000000
ANCHOR_SIGNER=dev
ANCHOR_CHAIN_ID=31337
# ops alerts: logged only until ALERTS_ARMED=1 and the token file exists; the token is never put in env
ALERTS_ARMED=0
ALERTS_TOKEN_FILE=
ALERTS_CHAT_ID=
ALERTS_TELEGRAM_API=
HL_BUILDER_ADDRESS=
OPS_KNOWN_ADDRESSES=
LOG_DIR=

# facilitator
FACILITATOR_PORT=8714
# mainnet settles stay off until X402_SETTLE_ARMED=1 AND the arming file exists (never set here)
X402_SETTLE_ARMED=0
X402_SETTLE_ARMED_FILE=
X402_USDG_EIP3009_MAINNET=0
# facilitator-only settings (apps/facilitator/src/env.ts); RHC_RPC_URL and RHC_TESTNET_RPC_URL are below
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SOLANA_RPC_URL=
SOLANA_DEVNET_RPC_URL=
FACILITATOR_SOL_KEYPAIR=
FACILITATOR_SOL_PASSWORD_FILE=
X402_PAYTO_EVM=
X402_PAYTO_SOL=
X402_PAYTO_IS_SWEEP=0
X402_SWEEP_TO=
FACILITATOR_FLOAT_MAX_USD=200
FACILITATOR_SIGNER=dev
FACILITATOR_CHAIN_ID=31337

# Robinhood Chain public RPCs (free, read-only use). Mainnet 4663, testnet 46630.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
