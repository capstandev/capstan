# Copy to .env for local runs. Never commit .env. Every value here is a safe local default.
API_PORT=8710
WS_PORT=8711
RELAY_PORT=8712
MCP_PORT=8713
FACILITATOR_PORT=8714
# docker-compose.yml (local only, non-default ports)
DATABASE_URL=postgres://capstan:capstan@127.0.0.1:55432/capstan
REDIS_URL=redis://127.0.0.1:56379
# Robinhood Chain public RPCs (free). Mainnet 4663, testnet 46630.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
