# Dependencies and forge output
node_modules/
out/
cache/
broadcast/
*.tsbuildinfo

# Secrets: never commit
.env*
*.env
*.env.*
.envrc
!.env.example
# VPS env templates: placeholders only (@DB_PASSWORD@ and friends), filled in on the server by provision.sh
!ops/server/etc/*.env
# Mainnet env overlays: public values and placeholders only (ops/mainnet/env-review.ts checks them)
!ops/mainnet/env/*.env
credentials/
secrets/
keystores/
*.key
*.pem
*.p12
*.pfx
*.keystore
.npmrc
.netrc
.pgpass
id_rsa*
id_ed25519*

# Private workspace material belongs in the separate private docs folder (../docs), never here.
/docs/
/plan/
/plans/
/todos/
/deploy/
/deploy-config/
/docker/
# Never ignore contracts/deployments/<chain>.json: it is the ONE committed deployment record.
# docker-compose.yml IS committed here (local Postgres/Redis for dev, no secrets); other compose/Docker files stay out.
AGENTS.md
CLAUDE.md
memories.md
TODO*
PLAN*
RESUME*
# macOS checkouts use core.ignorecase=true, so TODO*/PLAN*/RESUME* above also match lowercase source
# such as plan.ts. Re-include the lane source that is named that way (it must be committed).
!packages/spreads/src/plan.ts
!packages/spreads/test/plan/
!packages/spreads/test/plan/**
STATUS.md
Dockerfile*
!ops/server/test/standin/Dockerfile
docker-compose.*.yml
docker-compose.override.yml
compose*.yml
compose*.yaml

# Generated output and local data
dist/
coverage/
*.log
*.sql.gz
*.dump
*.bak
*.db
*.sqlite*
.DS_Store

# ws load run output (ops/load/ws-load.ts)
ops/load/last-run.json

# ops/fork local stack state (keys, logs, PIDs): never committed
ops/fork/.state/
ops/fork/.pids
