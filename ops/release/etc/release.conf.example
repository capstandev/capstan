# /etc/capstan-release/release.conf (root-owned, 0644; no secrets here: tokens live in their own 0600 env files).
# KEY=VALUE, read as text (never sourced). Command values are split on spaces: no quotes or spaces inside paths.
RR_HOME=/var/lib/capstan-release
# Owner commands run as root hand the runner home back to this user.
RUNNER_USER=capstan-release
WORK_DIR=/var/lib/capstan-release/backend
QUEUE_REF=queue/tu-queue
FLAG_FILE=/etc/capstan-release/ALLOW_REAL_DEPLOY
OWNER_TZ=America/Toronto
CADENCE_MINUTES=60
EXPECTED_COUNT=72
MIN_GAP_MINUTES=2
# The timer runs every minute: 30 passes = a 30-minute retry window for transient failures.
TRANSIENT_MAX=30
# An update that crashes its pass more than this many times in a row pauses the runner with one alert.
CRASH_MAX=3
PUBLIC_CI_EVERY_S=300
ARM_MIN_LEAD_MINUTES=10
SIGN_CHERRY_PICKS=1
STRESS_REPORT=/var/lib/capstan-release/release-stress.md
RELEASE_TOKEN_PROOF=/var/lib/capstan-release/release-token.proof
NOTIFY_PROOF=/var/lib/capstan-release/notify.proof
TELEGRAM_ENV=/etc/capstan-release/telegram.env
# TELEGRAM_API=https://api.telegram.org   (default; tests point it at a local stand-in Bot API)
GITHUB_RELEASE_ENV=/etc/capstan-release/github-release.env
# GITHUB_API=https://api.github.com and GITHUB_UPLOADS=https://uploads.github.com (defaults; tests use stand-ins).
# arm.sh refuses when any API base is not the real one.
# Light gate on the server: typecheck plus the tests of what the update touched (the full gate ran before launch).
GATE_CMD=/opt/capstan-release/bin/gate-light.sh
PRIVATE_PUSH_CMD=/opt/capstan-release/bin/push-private.sh
# ops/server/deploy.sh installed as capstan-deploy: health checks and its own auto-rollback. A runner rollback is a
# deploy of the previous sha through the same path.
DEPLOY_CMD=sudo -n /usr/local/sbin/capstan-deploy
ROLLBACK_CMD=sudo -n /usr/local/sbin/capstan-deploy
# Content checks per update (each one FAILS on production before the release and passes after).
CHECK_CMD=/opt/capstan-release/bin/check-update.sh
PUBLISH_CMD=/opt/capstan-release/bin/publish-public.sh
# Public copy of each update (bin/public-sync.sh, run by publish-public.sh as the runner): sync-public.py with the
# state template below, signed and pushed as capstandev. Prints the public sha (the GitHub Release targets it).
# The words and keys are set up once by the operator (README "Public copy: one-time server setup"); never in this file.
PUBLIC_SYNC_CMD=/opt/capstan-release/bin/public-sync.sh
# Root-owned template (root:capstan-release 0640): name, email, scrub rules, forbidden words, privateSha/publicSha.
PUBLIC_STATE=/etc/capstan-release/public/state.json
# capstandev SSH signing key (private key file, root:capstan-release 0640; its .pub is a signing key on capstandev).
PUBLIC_SIGNING_KEY=/etc/capstan-release/public/id_ed25519_sign
# Push key (write deploy key on capstandev/capstan) and pinned github.com host keys. Empty PUBLIC_PUSH_KEY: the
# runner's own ~/.ssh/config alias in PUBLIC_REMOTE_URL is used instead.
PUBLIC_PUSH_KEY=/etc/capstan-release/public/id_ed25519_push
PUBLIC_KNOWN_HOSTS=/etc/capstan-release/public/known_hosts
PUBLIC_REMOTE_URL=git@github.com:capstandev/capstan.git
# Optional, owner-only: {"<private sha>": "<public message>"} for a message that cannot go out as it is.
PUBLIC_MESSAGE_OVERRIDES=/etc/capstan-release/public/message-overrides.json
# Runner-owned work dir (0700): the copy repo, the live state and its map. Default $RR_HOME/public.
# PUBLIC_SYNC_HOME=/var/lib/capstan-release/public
GHREL_CMD=sudo -n /usr/local/sbin/capstan-release-ghrelease
NOTIFY_CMD=sudo -n /usr/local/sbin/capstan-release-notify
# Team post per release: poster $RR_HOME/posters/<tag>.png plus notes $RR_HOME/notes/<tag>.txt (both staged by the
# runner), sent by bin/announce-telegram.sh as root (the token file is root-only). Marked announced only on success;
# owed posts are retried one per pass, given up after ANNOUNCE_MAX_PASSES with one alert. ANNOUNCE_DRY_RUN=1 renders
# the parts into $RR_HOME/announce/<tag>.dry/ and sends nothing. Empty ANNOUNCE_CMD = the old text-only post.
ANNOUNCE_CMD=sudo -n /usr/local/sbin/capstan-release-announce
ANNOUNCE_DRY_RUN=0
ANNOUNCE_MAX_PASSES=30
# Per call: tries, first backoff (doubles), longest wait (a 429 waits Telegram's retry_after up to this).
ANNOUNCE_TRIES=4
ANNOUNCE_BACKOFF_S=2
ANNOUNCE_BACKOFF_MAX_S=60
PUBLIC_CI_CHECK_CMD=/opt/capstan-release/bin/public-ci-green.sh
HEALTHCHECK_CMD=
SYSTEMCTL=sudo -n /bin/systemctl
TIMER_UNIT=capstan-release.timer
