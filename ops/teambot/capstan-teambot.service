[Unit]
Description=Capstan team Telegram bot (commands, owner pause and resume, requests)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# never root (G4-02): its own account, reading the runner's folder as any other user can, and sudo only for the three
# runner wrappers in /etc/sudoers.d/capstan-teambot. systemd (as root) hands it a copy of the token file.
User=capstan-teambot
Group=capstan-teambot
LoadCredential=telegram.env:/etc/capstan-release/telegram.env
Environment=TEAMBOT_TELEGRAM_ENV=%d/telegram.env
ExecStart=/usr/local/sbin/teambot run
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
PrivateTmp=yes
UMask=0077
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
