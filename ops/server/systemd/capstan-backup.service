# Daily encrypted database backup (ops/server/backup.sh). Started by capstan-backup.timer.
[Unit]
Description=Capstan database backup
After=capstan-db.service
Requires=capstan-db.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/capstan-backup
# Memory caps: pg_dump and the encryption step; generous so a large dump is never killed.
MemoryHigh=1024M
MemoryMax=1536M
MemorySwapMax=256M
Nice=10
