# anchor poster jobs. One Unix user and one env file per service (DECISIONS #20). Installed by ops/server/provision.sh.
[Unit]
Description=Capstan anchor (anchor poster jobs)
After=network-online.target capstan-db.service 
Wants=network-online.target
Requires=capstan-db.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=capstan-anchor
Group=capstan-anchor
EnvironmentFile=/etc/capstan/anchor/env
WorkingDirectory=/opt/capstan/current
ExecStart=/usr/local/bin/bun /opt/capstan/current/apps/workers/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/capstan/anchor/anchor.jsonl
StandardError=append:/var/log/capstan/anchor/anchor.jsonl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
ReadWritePaths=/var/log/capstan/anchor
ReadOnlyPaths=/opt/capstan
# only this service's folder is visible under /etc/capstan
TemporaryFileSystem=/etc/capstan:ro
BindReadOnlyPaths=/etc/capstan/anchor

[Install]
WantedBy=multi-user.target capstan-workers.target
