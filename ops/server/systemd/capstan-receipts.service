# receipt signing job. One Unix user and one env file per service (DECISIONS #20). Installed by ops/server/provision.sh.
[Unit]
Description=Capstan receipts (receipt signing job)
After=network-online.target capstan-db.service 
Wants=network-online.target
Requires=capstan-db.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=capstan-receipts
Group=capstan-receipts
EnvironmentFile=/etc/capstan/receipts/env
WorkingDirectory=/opt/capstan/current
ExecStart=/usr/local/bin/bun /opt/capstan/current/apps/workers/src/index.ts
# Memory caps: about 35 to 60 MB measured; MemoryHigh throttles and reclaims, MemoryMax ends a runaway before the box swaps.
MemoryHigh=512M
MemoryMax=768M
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/capstan/receipts/receipts.jsonl
StandardError=append:/var/log/capstan/receipts/receipts.jsonl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
ReadWritePaths=/var/log/capstan/receipts
ReadOnlyPaths=/opt/capstan
# only this service's folder is visible under /etc/capstan
TemporaryFileSystem=/etc/capstan:ro
BindReadOnlyPaths=/etc/capstan/receipts

[Install]
WantedBy=multi-user.target capstan-workers.target
