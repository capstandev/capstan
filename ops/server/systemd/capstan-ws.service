# WebSocket gateway. One Unix user and one env file per service (DECISIONS #20). Installed by ops/server/provision.sh.
[Unit]
Description=Capstan ws (WebSocket gateway)
After=network-online.target capstan-db.service 
Wants=network-online.target
Requires=capstan-db.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=capstan-ws
Group=capstan-ws
EnvironmentFile=/etc/capstan/ws/env
WorkingDirectory=/opt/capstan/current
ExecStart=/usr/local/bin/bun /opt/capstan/current/apps/ws/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/capstan/ws/ws.jsonl
StandardError=append:/var/log/capstan/ws/ws.jsonl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
ReadWritePaths=/var/log/capstan/ws
ReadOnlyPaths=/opt/capstan
# only this service's folder is visible under /etc/capstan
TemporaryFileSystem=/etc/capstan:ro
BindReadOnlyPaths=/etc/capstan/ws

[Install]
WantedBy=multi-user.target
