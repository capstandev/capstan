# BullMQ jobs without keys. One Unix user and one env file per service (DECISIONS #20). Installed by ops/server/provision.sh.
[Unit]
Description=Capstan workers (BullMQ jobs without keys)
After=network-online.target capstan-db.service 
Wants=network-online.target
Requires=capstan-db.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=capstan-workers
Group=capstan-workers
EnvironmentFile=/etc/capstan/workers/env
WorkingDirectory=/opt/capstan/current
ExecStart=/usr/local/bin/bun /opt/capstan/current/apps/workers/src/index.ts
# Memory caps: about 155 MB measured; MemoryHigh throttles and reclaims, MemoryMax ends a runaway before the box swaps.
MemoryHigh=1200M
MemoryMax=1500M
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/capstan/workers/workers.jsonl
StandardError=append:/var/log/capstan/workers/workers.jsonl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
ReadWritePaths=/var/log/capstan/workers
# geo-db-refresh writes the shared DB-IP country file (api and relay read it)
ReadWritePaths=/var/lib/capstan/geo
ReadOnlyPaths=/opt/capstan
# only this service's folder is visible under /etc/capstan
TemporaryFileSystem=/etc/capstan:ro
BindReadOnlyPaths=/etc/capstan/workers

[Install]
WantedBy=multi-user.target capstan-workers.target
