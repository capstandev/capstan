# /etc/capstan/receipts/env (0640 root:capstan-receipts). Receipt signing job only, with the receipt keystore.
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
PROM_PORT=9717
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
REDIS_URL=redis://127.0.0.1:6379
WORKER_JOBS=receipt-sign
RECEIPT_SIGNER=keystore
RECEIPT_KEYSTORE_PATH=/etc/capstan/receipts/keystore.json
RECEIPT_KEYSTORE_PASSWORD_FILE=/etc/capstan/receipts/keystore.password
RECEIPT_CHAIN_ID=46630
ANCHOR_SIGNER=dev
ANCHOR_CHAIN_ID=31337
