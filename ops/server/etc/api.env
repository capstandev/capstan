# /etc/capstan/api/env: written once by provision.sh, then edited by the owner (0640 root:capstan-api).
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
API_PORT=8710
PROM_PORT=9710
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
REDIS_URL=redis://127.0.0.1:6379
RELAY_EGRESS_IP=@RELAY_EGRESS_IP@
# Caddy is the only way in and overwrites X-Forwarded-For, so the api reads the caller from it (off: every caller is
# 127.0.0.1 and every write is refused). The geo folder is shared: geo-db-refresh (workers) writes, api and relay read.
CAPSTAN_TRUST_FORWARDED_FOR=1
CAPSTAN_GEO_DIR=/var/lib/capstan/geo
X402_ENABLED=0
# The dashboard's web origins, comma separated, exact (https://host, no path, no wildcard). Empty means no CORS.
CAPSTAN_WEB_ORIGINS=
# Receipt verification (security r1 F1). RECEIPT_SIGNERS: the receipt signer address(es), comma separated; empty means
# every receipt reads invalid. The anchor address comes from contracts/deployments for the network's chain, never from
# here; until the anchor is deployed /verify answers pending or invalid, never valid.
RECEIPT_SIGNERS=
ANCHOR_RPC_URL=https://rpc.testnet.chain.robinhood.com
