# /etc/capstan/relay/env (0640 root:capstan-relay). Flags change only through capstan-relay-flag (logged).
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
RELAY_PORT=8712
PROM_PORT=9712
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
REDIS_URL=redis://127.0.0.1:6379
RELAY_EGRESS_ID=vps-1
RELAY_SUBMIT_ARMED=0
RELAY_ENABLED=1
HL_ENABLED=1
LIGHTER_304_ENABLED=1
LIGHTER_RH_ENABLED=1
ASTER_ENABLED=1
# The relay holds no key: receipts are signed by the receipt-sign job under capstan-receipts. TODO(owner): the relay
# config must accept RECEIPT_SIGNER=none when the relay lane wires the receipt-sign queue (integration point).
RECEIPT_SIGNER=none
