# /etc/capstan/facilitator/env (0640 root:capstan-facilitator)
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
FACILITATOR_PORT=8714
PROM_PORT=9714
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
REDIS_URL=redis://127.0.0.1:6379
FACILITATOR_ARMED=0
FACILITATOR_SIGNER=keystore
FACILITATOR_KEYSTORE_PATH=/etc/capstan/facilitator/keystore.json
FACILITATOR_KEYSTORE_PASSWORD_FILE=/etc/capstan/facilitator/keystore.password
FACILITATOR_CHAIN_ID=84532
