# /etc/capstan/workers/env (0640 root:capstan-workers). Every job except the anchor and receipt-sign jobs, which run
# under their own users with their own keystores. Add new drop-in jobs to WORKER_JOBS here.
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
PROM_PORT=9715
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
REDIS_URL=redis://127.0.0.1:6379
WORKER_JOBS=alerts-dispatch,builder-reconciler,catalog-sync,depeg-monitor,funding-forecaster,geo-db-refresh,ingest-aster,ingest-hl,ingest-lighter,ingest-readonly,lighter-rh-health,lock-snapshot,log-retention,ops-alerts,risk-compute,risk-refresh,spread-scan,staker-credits,usage-daily,x402-detect
LOG_DIR=/var/log/capstan
# geo-db-refresh writes the DB-IP country file here (world-readable 0644; api and relay read it)
CAPSTAN_GEO_DIR=/var/lib/capstan/geo
ALERTS_ARMED=0
ALERTS_TOKEN_FILE=/etc/capstan/workers/telegram-token
ALERTS_CHAT_ID=
HL_BUILDER_ADDRESS=
OPS_KNOWN_ADDRESSES=
ANCHOR_SIGNER=dev
ANCHOR_CHAIN_ID=31337
