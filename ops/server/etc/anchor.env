# /etc/capstan/anchor/env (0640 root:capstan-anchor). Anchor jobs only, with the anchor poster keystore.
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
PROM_PORT=9716
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
REDIS_URL=redis://127.0.0.1:6379
WORKER_JOBS=merkle-anchor,root-indexer
ANCHOR_RPC_URL=https://rpc.testnet.chain.robinhood.com
ANCHOR_ARMED=0
ANCHOR_SIGNER=keystore
ANCHOR_KEYSTORE_PATH=/etc/capstan/anchor/keystore.json
ANCHOR_KEYSTORE_PASSWORD_FILE=/etc/capstan/anchor/keystore.password
ANCHOR_CHAIN_ID=46630
