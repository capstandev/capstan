# /etc/capstan/ws/env (0640 root:capstan-ws)
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
WS_PORT=8711
PROM_PORT=9711
REDIS_URL=redis://127.0.0.1:6379
# the catalog (market ids and assets that may be subscribed, tickers, plan signers) and the real client IP from Caddy
# for the per-IP connection cap (security review r1 F6)
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
CAPSTAN_TRUST_FORWARDED_FOR=1
