# /etc/capstan/mcp/env (0640 root:capstan-mcp)
CAPSTAN_NETWORK=testnet
PUBLIC_API_HOST=@API_HOST@
LOG_LEVEL=info
OTLP_FILE=/var/log/capstan/@SVC@/spans.jsonl
MCP_PORT=8713
PROM_PORT=9713
API_BASE_URL=http://127.0.0.1:8710/v1
# Host headers the MCP transport accepts: Caddy forwards the public api host (r1:9 F-3); loopback for local probes
MCP_ALLOWED_HOSTS=@API_HOST@,127.0.0.1:8713,localhost:8713
# request_logs only (MCP tool calls for the usage report, hashed client ids)
DATABASE_URL=postgres://capstan:@DB_PASSWORD@@127.0.0.1:5432/capstan
